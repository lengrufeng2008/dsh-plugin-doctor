{
  "name": "dsh-plugin-doctor",
  "version": "0.1.0",
  "description": "Static check of an installed DSH profile: dependencies, bundle patches, and duplicate patch ids/names.",
  "type": "module",
  "bin": { "dsh-plugin-doctor": "bin/dsh-plugin-doctor.mjs" },
  "exports": { ".": "./plugin/index.js", "./doctor": "./src/doctor.mjs", "./plugin": "./plugin/index.js", "./icon": "./icon.svg" },
  "files": ["bin", "src", "plugin", "skills", "icon.svg", "README.md", "NOTICE.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./plugin/cordis.patch.yml" } },
  "engines": { "node": ">=20" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "doctor", "profile", "maintenance"],
  "license": "MIT",
  "scripts": { "test": "node --test test/*.test.mjs" },
  "repository": { "type": "git", "url": "https://github.com/lengrufeng2008/dsh-plugin-doctor" }
}
